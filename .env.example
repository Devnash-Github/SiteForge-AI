APP_NAME="SiteForge AI"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=siteforge
DB_USERNAME=siteforge
DB_PASSWORD=siteforge123

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# --- SiteForge AI ---------------------------------------------------------
# AI writing + AI fact extraction. Set ONE of the keys below (or both and pick with AI_PROVIDER).
# With no key, websites are built from confirmed facts with neutral wording.
# AI_PROVIDER=        # gemini | groq  (empty = Gemini if its key is set, otherwise Groq)

# Groq (OpenAI-compatible) — https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Google Gemini — https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_TIMEOUT=60
GEMINI_RETRIES=2

# Web research: none | serper | google_cse
SEARCH_PROVIDER=none
SEARCH_API_KEY=
# Only for SEARCH_PROVIDER=google_cse
GOOGLE_CSE_ID=
SEARCH_MAX_RESULTS=8

# Uploaded files. "local" is a private disk; images are served through an authorised route.
SITEFORGE_MEDIA_DISK=local
SITEFORGE_MAX_UPLOAD_KB=10240
SITEFORGE_FETCH_TIMEOUT=15
# Development only: allow fetching localhost / private-network URLs (disables SSRF protection).
SITEFORGE_ALLOW_PRIVATE_HOSTS=false
